<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="10dp" />
            <corners android:radius="5dp" />
            <solid android:color="#101720" />
            <stroke android:width="1dp" android:color="#344553" />
        </shape>
    </item>

    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="10dp" />
                <corners android:radius="5dp" />
                <solid android:color="#263D48" />
            </shape>
        </clip>
    </item>

    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="10dp" />
                <corners android:radius="5dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#087E91"
                    android:centerColor="#00BCD4"
                    android:endColor="#73F4FF" />
            </shape>
        </clip>
    </item>
</layer-list>
