<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="42dp"
        android:paddingEnd="26dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/freezy_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_update_badge"
            android:letterSpacing="0.12"
            android:text="@string/public_edition"
            android:textAllCaps="true"
            android:textColor="#D996FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/license_active"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/public_description"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_update_modal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="USUARIO" android:textColor="#8F8798" android:textSize="10sp" />
            <TextView android:id="@+id/tv_public_user" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:background="#2D2535" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVACIÓN" android:textColor="#8F8798" android:textSize="10sp" />
            <TextView android:id="@+id/tv_public_activation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_primary" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="EXPIRACIÓN" android:textColor="#8F8798" android:textSize="10sp" />
            <TextView android:id="@+id/tv_public_expiration" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/success" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_public_whatsapp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_update_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="ABRIR CANAL DE WHATSAPP"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_public_bubble"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_update_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="ACTIVAR BURBUJA"
            android:textColor="#D9B8ED"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_public_fake_lag"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_update_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="PREPARAR FAKE LAG"
            android:textColor="#D9B8ED"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_public_root"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_update_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="COMPROBAR ROOT"
            android:textColor="#D9B8ED"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_public_root_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Root aún no comprobado"
            android:textColor="#8F8798"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_public_logout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_update_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="CERRAR SESIÓN"
            android:textColor="#D9B8ED"
            android:textSize="13sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/version_label" android:textColor="#6F6878" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
