<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="4dp" />
            <corners android:radius="2dp" />
            <solid android:color="#26313C" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="4dp" />
                <corners android:radius="2dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#087E91"
                    android:endColor="#73F4FF" />
            </shape>
        </clip>
    </item>
</layer-list>
