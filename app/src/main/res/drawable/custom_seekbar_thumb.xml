<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow / Rim -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00E5FF" />
            <size android:width="16dp" android:height="16dp" />
        </shape>
    </item>
    <!-- Dark Inner Rim -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="#0B121A" />
        </shape>
    </item>
    <!-- Center Core Point -->
    <item android:top="4.5dp" android:bottom="4.5dp" android:left="4.5dp" android:right="4.5dp">
        <shape android:shape="oval">
            <solid android:color="#00E5FF" />
        </shape>
    </item>
</layer-list>
