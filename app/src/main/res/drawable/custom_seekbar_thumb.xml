<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Tactile Capsule Body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1D24" />
            <stroke android:color="#424B5C" android:width="1.5dp" />
            <corners android:radius="4dp" />
            <size android:width="12dp" android:height="24dp" />
        </shape>
    </item>
    <!-- Center Neon Indicator Line -->
    <item android:left="5dp" android:right="5dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorAccentPrimary" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
