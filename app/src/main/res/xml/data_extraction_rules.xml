<?xml version="1.0" encoding="utf-8"?>
<!-- Deniega cualquier respaldo en la nube o transferencia entre dispositivos.
     allowBackup ya está en false; esto es la defensa en profundidad explícita. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
