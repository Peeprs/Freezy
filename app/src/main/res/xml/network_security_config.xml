<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration — Freezy (RELEASE)
    Solo HTTPS. Sin excepciones cleartext ni confianza en certificados de usuario.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
