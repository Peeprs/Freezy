<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration — Freezy
    Deshabilita tráfico en texto plano (HTTP) globalmente.
    Solo permite cleartext para localhost en debug (emulador).
-->
<network-security-config>
    <!-- Política base: SOLO HTTPS, sin tráfico en texto plano -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Excepción para desarrollo local (emulador Android) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Si necesitas conectarte a localhost durante debug -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
