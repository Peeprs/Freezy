<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <!-- HUD Superior para el mapeo táctil -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_glass_menu"
        android:elevation="6dp"
        android:padding="10dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_toggle_mapeo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Mostrar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2A2A2A" />

        <Button
            android:id="@+id/btn_aceptar_mapeo"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Aceptar"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:backgroundTint="#0084FF"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <!-- Barra de progreso vertical a la izquierda para tamaño -->
    <LinearLayout
        android:id="@+id/layout_seekbar_container"
        android:layout_width="60dp"
        android:layout_height="240dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_glass_menu"
        android:elevation="6dp"
        android:visibility="gone"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talla"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- SeekBar vertical (Rotado 270 grados en código o mediante atributos) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <!-- SeekBar rotado -->
            <SeekBar
                android:id="@+id/seekbar_circle_size"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="250"
                android:progress="80"
                android:progressDrawable="@drawable/custom_seekbar_track"
                android:thumb="@drawable/custom_seekbar_thumb"
                android:splitTrack="false"
                android:rotation="270" />
        </FrameLayout>
    </LinearLayout>

    <!-- El Círculo Arrastrable (Target del Botón de Disparo) -->
    <FrameLayout
        android:id="@+id/circle_target_container"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:background="#00000000">

        <!-- Círculo semitransparente con borde azul -->
        <View
            android:id="@+id/circle_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_circle_outline"
            android:alpha="0.8" />

        <!-- Punto central de precisión -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/custom_seekbar_thumb" />
    </FrameLayout>

</FrameLayout>
