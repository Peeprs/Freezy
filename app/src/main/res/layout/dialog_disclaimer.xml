<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_disclaimer_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ DESCARGO DE RESPONSABILIDAD"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:gravity="center" />

    <!-- Tile: Contenido del Disclaimer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_tile"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tv_disclaimer_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Si bien esta herramienta NO altera los archivos originales del juego, te otorga una ventaja extrema.\n\n⚠️ Uso de Datos y Dispositivo:\nSolicitamos acceso al 'Uso de Datos' para monitorear la ejecución del juego y activar las funciones correctamente. También almacenamos el nombre de tu dispositivo para la detección y prevención de fallas técnicas específicas reportadas anteriormente en modelos similares.\n\nEl uso abusivo puede causar baneos. El uso de esta herramienta es bajo tu propia responsabilidad."
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:lineSpacingExtra="4sp"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_accept_risk"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="ACEPTO EL RIESGO"
        android:textColor="#0D0E12"
        android:textStyle="bold"
        android:background="@drawable/shape_button_tech"
        android:elevation="4dp"
        android:layout_marginBottom="12dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_exit_app"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="SALIR"
        android:textColor="#F5F6F8"
        android:textStyle="bold"
        android:background="@drawable/shape_button_tech"
        android:elevation="4dp" />
</LinearLayout>
