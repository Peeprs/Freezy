<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghost_floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_floating_ghost"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:elevation="8dp">

    <ImageView
        android:id="@+id/iv_ghost_floating_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_ghost"
        android:tint="#00E5FF"
        android:contentDescription="Ghost Icon"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/tv_ghost_floating_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GHOST"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginEnd="8dp" />

    <!-- Status Indicator Pill / LED -->
    <TextView
        android:id="@+id/tv_ghost_floating_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ON"
        android:textColor="#39FF14"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/shape_tab_back"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp" />

</LinearLayout>
