<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/enemy_pull_floating_root"
    android:layout_width="52dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_enemy_pull"
    android:elevation="10dp"
    android:padding="2dp">

    <TextView
        android:id="@+id/pull_direction_up"
        android:layout_width="48dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="↑"
        android:textColor="#8A9BA8"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Enemy Pull hacia arriba" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#354D5C" />

    <TextView
        android:id="@+id/pull_direction_down"
        android:layout_width="48dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="↓"
        android:textColor="#8A9BA8"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Enemy Pull hacia abajo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#354D5C" />

    <TextView
        android:id="@+id/pull_direction_left"
        android:layout_width="48dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="←"
        android:textColor="#8A9BA8"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Enemy Pull hacia la izquierda" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#354D5C" />

    <TextView
        android:id="@+id/pull_direction_right"
        android:layout_width="48dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="→"
        android:textColor="#8A9BA8"
        android:textSize="24sp"
        android:textStyle="bold"
        android:contentDescription="Enemy Pull hacia la derecha" />

</LinearLayout>
