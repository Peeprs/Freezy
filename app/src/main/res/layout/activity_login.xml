<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundBase">

    <!-- SPLASH / LOADING CONTAINER -->
    <LinearLayout
        android:id="@+id/layout_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tv_splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[>] Obteniendo datos..."
            android:textColor="@color/colorAccentPrimary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- LOGIN FORM CONTAINER -->
    <FrameLayout
        android:id="@+id/layout_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_blue"
            android:padding="32dp">

            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccentPrimary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_label_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_user"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:textColorHint="@color/colorTextMuted"
                android:textColor="@color/colorTextPrimary"
                android:background="@drawable/bg_glass_tile"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tv_label_license_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_key"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:textColorHint="@color/colorTextMuted"
                android:textColor="@color/colorTextPrimary"
                android:background="@drawable/bg_glass_tile"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:layout_marginBottom="32dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:textColor="#0D0E12"
                android:textStyle="bold"
                android:background="@drawable/shape_button_tech"
                android:elevation="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_getkey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_tile"
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:elevation="4dp" />

        </LinearLayout>

        <!-- BOTÓN SOCIAL TELEGRAM (esquina inferior izquierda) -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/iv_social_ring_tg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/social_ring_arc" />

            <ImageButton
                android:id="@+id/btn_social_telegram"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/social_circle_bg"
                android:contentDescription="Telegram"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_telegram" />
        </FrameLayout>

        <!-- BOTÓN SOCIAL TIKTOK (esquina inferior derecha) -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/iv_social_ring_tt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/social_ring_arc" />

            <ImageButton
                android:id="@+id/btn_social_tiktok"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/social_circle_bg"
                android:contentDescription="TikTok"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tiktok" />
        </FrameLayout>
    </FrameLayout>

</FrameLayout>

