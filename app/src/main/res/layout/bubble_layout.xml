<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Burbuja Fake Lag Cyber-Tech con Cristal Congelado y Picos de Nieve -->
    <FrameLayout
        android:id="@+id/bubble_face_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">
        
        <com.freezy.ui.CyberBubbleView
            android:id="@+id/cyber_bubble_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Dummy hidden views for backward compatibility -->
        <ImageView
            android:id="@+id/bubble_main_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>