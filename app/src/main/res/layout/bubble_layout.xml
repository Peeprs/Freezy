<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- CARA 1: Burbuja Fake Lag -->
    <FrameLayout
        android:id="@+id/bubble_face_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.freezy.ui.CyberBubbleView
            android:id="@+id/cyber_bubble_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Dummy hidden views for backward compatibility -->
        <ImageView
            android:id="@+id/bubble_main_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/bubble_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- CARA 2: Freezy Modular Cheat Menu (Glassmorphism) -->
    <LinearLayout
        android:id="@+id/recoil_menu"
        android:layout_width="450dp"
        android:layout_height="280dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@drawable/bg_glass_menu">

        <!-- ============================================================== -->
        <!-- Barra Lateral Izquierda: Navegación Vertical + Botón Regresar -->
        <!-- ============================================================== -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="10dp">

            <!-- Tab 1: Combate / Aimbot (Calavera) -->
            <ImageButton
                android:id="@+id/tab_combat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/shape_tab_active"
                android:src="@drawable/ic_skull"
                android:tint="#00E5FF"
                android:contentDescription="Combate"
                android:padding="8dp" />

            <!-- Tab 2: Visuales / ESP (Stickman con arma) -->
            <ImageButton
                android:id="@+id/tab_esp"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_tab_inactive"
                android:src="@drawable/ic_enemy"
                android:tint="#7E8B9B"
                android:contentDescription="Enemigos"
                android:padding="8dp" />

            <!-- Espacio flexible para empujar el botón de regresar al fondo -->
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Botón Regresar / Minimizar abajo a la izquierda -->
            <ImageButton
                android:id="@+id/btn_back_to_lag"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/shape_tab_back"
                android:src="@drawable/ic_arrow_back"
                android:tint="#A0B2C6"
                android:contentDescription="Regresar"
                android:padding="8dp" />
        </LinearLayout>

        <!-- ============================================================== -->
        <!-- Contenedor Principal Derecho: Módulos con Glassmorphism        -->
        <!-- ============================================================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Encabezado sutil superior -->
            <LinearLayout
                android:id="@+id/menu_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/menu_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FREEZY • HUD"
                    android:textColor="#00E5FF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE"
                    android:textColor="#39FF14"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/shape_tab_back"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:overScrollMode="never">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- ====================================================== -->
                    <!-- SECCIÓN 1: COMBATE / AIMBOT (Modular: 2 Columnas)       -->
                    <!-- ====================================================== -->
                    <LinearLayout
                        android:id="@+id/combat_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Módulo 1: Aimbot Principal -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_glass_card"
                            android:padding="8dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AIMBOT MAIN"
                                android:textColor="#00E5FF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:layout_marginBottom="6dp" />

                            <Switch
                                android:id="@+id/recoil_switch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Enable Aimbot"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:track="@drawable/custom_switch_track"
                                android:thumb="@drawable/custom_switch_thumb"
                                android:splitTrack="false"
                                android:switchMinWidth="38dp" />

                            <TextView
                                android:id="@+id/status_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Aimbot: OFF | En espera"
                                android:textColor="#8A9BA8"
                                android:textSize="9sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#20FFFFFF"
                                android:layout_marginVertical="8dp" />

                            <Switch
                                android:id="@+id/sniper_switch_switch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sniper Patch"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:track="@drawable/custom_switch_track"
                                android:thumb="@drawable/custom_switch_thumb"
                                android:splitTrack="false"
                                android:switchMinWidth="38dp" />

                            <TextView
                                android:id="@+id/sniper_switch_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Patch: No aplicado"
                                android:textColor="#8A9BA8"
                                android:textSize="9sp" />

                        </LinearLayout>

                        <!-- Módulo 2: Sniper Assist -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_glass_card"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SNIPER ASSIST"
                                android:textColor="#00E5FF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:layout_marginBottom="6dp" />

                            <Switch
                                android:id="@+id/sniper_scope_switch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sniper Scope"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:track="@drawable/custom_switch_track"
                                android:thumb="@drawable/custom_switch_thumb"
                                android:splitTrack="false"
                                android:switchMinWidth="38dp" />

                            <Switch
                                android:id="@+id/sniper_body_switch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Apuntar al Cuerpo"
                                android:textColor="#CFD8DC"
                                android:textSize="10sp"
                                android:track="@drawable/custom_switch_track"
                                android:thumb="@drawable/custom_switch_thumb"
                                android:splitTrack="false"
                                android:switchMinWidth="38dp" />

                            <TextView
                                android:id="@+id/sniper_scope_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Sniper: OFF | Cabeza"
                                android:textColor="#8A9BA8"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- ====================================================== -->
                    <!-- SECCIÓN 2: ENEMIGOS / ESP (Modular: 2 Columnas)         -->
                    <!-- ====================================================== -->
                    <LinearLayout
                        android:id="@+id/esp_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <!-- COLUMNA 1: TRAZADOS Y FILTROS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <!-- Tarjeta 1: ESP TRAZADOS -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_glass_card"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ESP TRAZADO"
                                    android:textColor="#00E5FF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.05"
                                    android:layout_marginBottom="4dp" />

                                <Switch
                                    android:id="@+id/esp_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="ESP Master"
                                    android:textColor="#FFFFFF"
                                    android:textSize="11sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <Switch
                                    android:id="@+id/esp_box_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ESP Box"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <Switch
                                    android:id="@+id/esp_skeleton_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ESP Skeleton"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <Switch
                                    android:id="@+id/esp_line_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ESP Línea"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <Switch
                                    android:id="@+id/esp_count_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ESP Count"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />
                            </LinearLayout>

                            <!-- Tarjeta 2: FILTROS & EQUIPO -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_glass_card"
                                android:padding="8dp"
                                android:layout_marginTop="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FILTROS &amp; EQUIPO"
                                    android:textColor="#00E5FF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.05"
                                    android:layout_marginBottom="4dp" />

                                <Switch
                                    android:id="@+id/esp_ignore_knocked_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Ignore Knocked"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <Switch
                                    android:id="@+id/esp_team_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ESP Team"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- COLUMNA 2: INFORMACIÓN & PERSONALIZACIÓN -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Tarjeta 3: INFORMACIÓN ENEMIGO -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_glass_card"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ESP INFORMACIÓN"
                                    android:textColor="#00E5FF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.05"
                                    android:layout_marginBottom="4dp" />

                                <Switch
                                    android:id="@+id/esp_health_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="ESP Health"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <Switch
                                    android:id="@+id/esp_name_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ESP Name"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <Switch
                                    android:id="@+id/esp_distance_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ESP Distance"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <Switch
                                    android:id="@+id/esp_weapon_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="ESP Weapon"
                                    android:textColor="#CFD8DC"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />
                            </LinearLayout>

                            <!-- Tarjeta 4: CUSTOMIZATION -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_glass_card"
                                android:padding="8dp"
                                android:layout_marginTop="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CUSTOMIZATION"
                                    android:textColor="#00E5FF"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.05"
                                    android:layout_marginBottom="4dp" />

                                <Switch
                                    android:id="@+id/esp_rgb_switch"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Color RGB (Anim)"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:track="@drawable/custom_switch_track"
                                    android:thumb="@drawable/custom_switch_thumb"
                                    android:splitTrack="false"
                                    android:switchMinWidth="38dp" />

                                <TextView
                                    android:id="@+id/esp_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Color: Verde"
                                    android:textColor="#8A9BA8"
                                    android:textSize="9sp" />

                                <SeekBar
                                    android:id="@+id/esp_color_seekbar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:max="7"
                                    android:progress="1"
                                    android:progressDrawable="@drawable/custom_seekbar_track"
                                    android:thumb="@drawable/custom_seekbar_thumb"
                                    android:splitTrack="false" />

                                <TextView
                                    android:id="@+id/esp_origin_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Origen línea: Abajo"
                                    android:textColor="#8A9BA8"
                                    android:textSize="9sp" />

                                <SeekBar
                                    android:id="@+id/esp_origin_seekbar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:max="2"
                                    android:progress="0"
                                    android:progressDrawable="@drawable/custom_seekbar_track"
                                    android:thumb="@drawable/custom_seekbar_thumb"
                                    android:splitTrack="false" />

                                <TextView
                                    android:id="@+id/esp_width_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Grosor línea: 3px"
                                    android:textColor="#8A9BA8"
                                    android:textSize="9sp" />

                                <SeekBar
                                    android:id="@+id/esp_width_seekbar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:max="9"
                                    android:progress="2"
                                    android:progressDrawable="@drawable/custom_seekbar_track"
                                    android:thumb="@drawable/custom_seekbar_thumb"
                                    android:splitTrack="false" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>
            </ScrollView>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>